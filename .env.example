# =============================================================================
# Gemini (Google Generative AI) — drives generateText / reviewText / generateTextStream /
# reviewTextStream in lib/ai.ts. Provider abstracted behind those helpers; swapping vendors
# is a one-file change.
# =============================================================================
GEMINI_API_KEY=
# Default model for all stages except the heavy text-generator drafting pass.
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
# Review/critique model (zachgpt-review, pr-reviewer).
GEMINI_MODEL_REVIEW=gemini-2.5-flash
# Heavy drafting stage — pinned to gemini-2.5-pro for the text-generator step
# (both main blog + standalone "custom blog" pipelines).
GEMINI_MODEL_TEXTGEN=gemini-2.5-pro

# =============================================================================
# OpenAI (used for web search via gpt-4o-search-preview, and JSON outline calls)
# =============================================================================
OPENAI_API_KEY=sk-...
OPENAI_SEARCH_MODEL=gpt-5-search-api

# =============================================================================
# Educative publishing
# =============================================================================
# flask-auth cookie value (do NOT include the "flask-auth=" prefix)
EDUCATIVE_FLASK_AUTH=.ejy...
# Separate session cookie for course/collection API (from SD Path cookies)
EDUCATIVE_COURSE_FLASK_AUTH=.ejw....
# Author ID used when publishing content
EDUCATIVE_AUTHOR_ID=10370001
# Optional: D2 SVG generator path (e.g. /api/author/.../d2/generate). Leave empty to skip server-side D2 rendering.
EDUCATIVE_D2_PATH=

# =============================================================================
# Google Sheets write-back (optional — only needed for bulk mobile shorts)
# Create a service account at console.cloud.google.com, enable Sheets API,
# download the JSON key, paste it as a single-line JSON string here.
# Share each Google Sheet with the service account email (Editor access).
# =============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Publishing channels (WordPress / dev.to / extra Educative accounts)
# =============================================================================
# Channels are configured in the UI at /channels and stored in data/channels/*.json
# (gitignored, along with the rest of data/). No env vars are required for them.
#
# dev.to has no image-upload API, so a dev.to channel pushes generated images to a PUBLIC
# GitHub repo (owner/repo/branch/token configured per channel on /channels) and links the
# commit-pinned raw.githubusercontent.com URLs. The GitHub token needs Contents: Read and write.
#
# Optional fallback used only when a dev.to channel has no GitHub repo configured: the public
# origin of THIS app, so images resolve as ${PUBLIC_BASE_URL}/api/images/...
# A per-channel "Public base URL" field overrides this.
PUBLIC_BASE_URL=

# Default Educative blog template used when a channel leaves Template ID blank.
EDUCATIVE_TEMPLATE_ID=5002

# --- Default dev.to channel ---------------------------------------------------------------
# Setting DEVTO_API_KEY seeds a "DEV Community" channel in the publish menu with no UI setup.
# Extra dev.to accounts are added on /channels; this one is just the convenient default.
DEVTO_API_KEY=
DEVTO_TAGS=
DEVTO_SERIES=
DEVTO_ORGANIZATION_ID=
# true publishes live; anything else keeps new articles as dev.to drafts.
DEVTO_PUBLISHED=
# Public repo hosting article images. The token needs Contents: Read and write.
# Without a token, text-only articles still publish; articles with images are refused.
DEVTO_GITHUB_OWNER=
DEVTO_GITHUB_REPO=
DEVTO_GITHUB_BRANCH=main
DEVTO_GITHUB_PATH_PREFIX=images
DEVTO_GITHUB_TOKEN=
