# =============================================================================
# Copy this file to .env.local and fill in every value before running the app.
# Never commit .env.local — it is already in .gitignore.
# =============================================================================

# =============================================================================
# OpenAI — all AI generation (text, outlines, search)
# =============================================================================
OPENAI_API_KEY=sk-...

# Models (defaults shown — override only if you want a different model)
OPENAI_MODEL_DEFAULT=gpt-5.4
OPENAI_MODEL_TEXTGEN=gpt-5.4
OPENAI_MODEL_LIGHT=gpt-5.4-mini
OPENAI_SEARCH_MODEL=gpt-5-search-api

# =============================================================================
# NextAuth — Google OAuth login
# Generate a secret with: openssl rand -base64 32
# =============================================================================
NEXTAUTH_SECRET=<random-32-byte-secret>
NEXTAUTH_URL=http://localhost:3000

# Google OAuth app credentials (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# Restrict login to a single domain, e.g. educative.io (leave empty to allow any Google account)
ALLOWED_DOMAIN=educative.io

# Comma-separated list of emails that get admin privileges inside the app
ADMIN_EMAILS=you@educative.io,teammate@educative.io

# =============================================================================
# Educative publishing — Mobile Shorts and Mobile Course workflows
# Both cookies are session tokens grabbed from browser DevTools while logged
# in to educative.io. Cookie name is "flask-auth"; paste only the VALUE here.
# =============================================================================

# Primary flask-auth cookie (for author accounts other than EDUCATIVE_AUTHOR_ID)
EDUCATIVE_FLASK_AUTH=.ejy...

# flask-auth cookie for the collection/course API when authorId = EDUCATIVE_AUTHOR_ID
# (grab from the SD Path editor cookies — usually starts with .ejw)
EDUCATIVE_COURSE_FLASK_AUTH=.ejw...

# Numeric author ID of the Educative account used to publish content
EDUCATIVE_AUTHOR_ID=10370001
# Same value — exposed to the browser so the Mobile Course UI can pre-fill it
NEXT_PUBLIC_EDUCATIVE_AUTHOR_ID=10370001

# Template collection ID used by the blog/lesson pipeline (default: 5002)
EDUCATIVE_TEMPLATE_ID=5002

# Optional: D2 SVG generator path for server-side diagram rendering
# Example: /api/author/10370001/d2/generate — leave empty to skip
EDUCATIVE_D2_PATH=

# =============================================================================
# Google Sheets write-back — bulk mobile shorts only
# 1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
# 2. Create a service account, enable the Google Sheets API on the project
# 3. Generate a JSON key and paste the entire JSON as a single line here
# 4. Share each Google Sheet with the service account email (Editor access)
# =============================================================================
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# =============================================================================
# Publishing channels (WordPress / dev.to / extra Educative accounts)
# =============================================================================
# Channels are configured in the UI at /channels and stored in data/channels/*.json
# (gitignored, along with the rest of data/). No env vars are required for them.
#
# dev.to has no image-upload API, so a dev.to channel pushes generated images to a PUBLIC
# GitHub repo (owner/repo/branch/token configured per channel on /channels) and links the
# commit-pinned raw.githubusercontent.com URLs. The GitHub token needs Contents: Read and write.
#
# Optional fallback used only when a dev.to channel has no GitHub repo configured: the public
# origin of THIS app, so images resolve as ${PUBLIC_BASE_URL}/api/images/...
# A per-channel "Public base URL" field overrides this.
PUBLIC_BASE_URL=

# --- Default dev.to channel ---------------------------------------------------------------
# Setting DEVTO_API_KEY seeds a "DEV Community" channel in the publish menu with no UI setup.
# Extra dev.to accounts are added on /channels; this one is just the convenient default.
DEVTO_API_KEY=
DEVTO_TAGS=
DEVTO_SERIES=
DEVTO_ORGANIZATION_ID=
# true publishes live; anything else keeps new articles as dev.to drafts.
DEVTO_PUBLISHED=
# Public repo hosting article images. The token needs Contents: Read and write.
# Without a token, text-only articles still publish; articles with images are refused.
DEVTO_GITHUB_OWNER=
DEVTO_GITHUB_REPO=
DEVTO_GITHUB_BRANCH=main
DEVTO_GITHUB_PATH_PREFIX=images
DEVTO_GITHUB_TOKEN=
